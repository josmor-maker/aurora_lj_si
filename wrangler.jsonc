// Cloudflare Workers config: serves this repo as a static site (no build step).
// Files are served straight from the repo. Requests that match no file (the form's /api/first-visit, unknown URLs)
// go to worker.js, which handles the form and serves 404.html for the rest. Works with Wrangler 3 and 4.
{
  "name": "aurora-lj",
  "compatibility_date": "2026-11-26",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "vars": {
    "VISIT_TO": "info@auroracoworking.com"
  }
}
